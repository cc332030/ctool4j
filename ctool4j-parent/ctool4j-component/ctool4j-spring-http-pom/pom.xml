    <modules>
        <module>ctool4j-spring-base</module>
        <module>ctool4j-spring-javax</module>
        <module>ctool4j-spring-security-base</module>
        <module>ctool4j-spring-security-javax</module>
        <!--
            jakarta 侧模块（ctool4j-spring-jakarta / ctool4j-spring-security-jakarta）暂不登记：
            它们的适配器要用 Spring 6 的 ServletServerHttpRequest（jakarta 版 spring-web）才能解包，
            而当前依赖矩阵是 Spring 5.3 / Boot 2.x（javax），登记进来必然编译失败。
            代码已就位，待依赖矩阵升到 Spring 6 / Boot 3 时把两个 module 加回本列表即可。
        -->
    </modules>

