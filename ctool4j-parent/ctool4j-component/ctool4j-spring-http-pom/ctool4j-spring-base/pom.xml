<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.c332030</groupId>
        <artifactId>ctool4j-spring-http-pom</artifactId>
        <version>1.1.20260918-SNAPSHOT</version>
    </parent>

    <artifactId>ctool4j-spring-base</artifactId>

    <dependencies>

        <!-- Spring MVC/Security 的扩展点签名含 Servlet 类型、无法直接抽象，本模块只声明抽象契约（用 ctool4j-http-base 的类型） -->
        <dependency>
            <groupId>com.c332030</groupId>
            <artifactId>ctool4j-http-base</artifactId>
        </dependency>

        <!-- @ConfigurationProperties 组合注解的元注解来自 Spring Boot；承载在抽象契约层，避免让业务模块被反向依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>

        <!-- cors 配置与工具（无 Servlet 类型）承载在本层：两侧适配器共用同一份，避免为 cors 再建两侧模块 -->
        <dependency>
            <groupId>com.c332030</groupId>
            <artifactId>ctool4j-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.c332030</groupId>
            <artifactId>ctool4j-definition</artifactId>
        </dependency>

        <!-- @CAutowiredScan 自定义注入注解来自该处理器模块 -->
        <dependency>
            <groupId>com.c332030</groupId>
            <artifactId>ctool4j-autowired-processor</artifactId>
        </dependency>

    </dependencies>

</project>
